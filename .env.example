# ------------------------------------------------------------------
# BaryoBenta API environment template.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# On Vercel, set the same variables under Project > Settings >
# Environment Variables.
# ------------------------------------------------------------------

# Full Supabase connection string (Session pooler, port 6543):
# Supabase dashboard > Project Settings > Database > Connection string
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres?sslmode=require

# Secret used to sign JWT login tokens. Generate a long random string,
# e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<replace-with-a-long-random-string>

# Optional: instead of DATABASE_URL you may set the parts individually.
# DB_HOST=<host>
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=<user>
# DB_PASSWORD=<password>
