<?xml version="1.0" encoding="utf-8"?>
<!-- Inset (pressed) neumorphic surface for input fields: inner shadow top-left,
     inner highlight bottom-right -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_dark" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:left="@dimen/neu_rim_sm"
        android:top="@dimen/neu_rim_sm">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_light" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:bottom="@dimen/neu_rim_sm"
        android:left="@dimen/neu_rim_sm"
        android:right="@dimen/neu_rim_sm"
        android:top="@dimen/neu_rim_sm">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
