<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/header_my_listings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/header"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/button_my_listings_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_my_listings"
            android:textColor="@color/white"
            android:textSize="@dimen/text_card_title"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/text_my_listings_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_my_listings"
        android:layout_marginHorizontal="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:text="@string/my_listings_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="italic" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_my_listings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/text_my_listings_subtitle"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        tools:listitem="@layout/item_my_listing" />

    <TextView
        android:id="@+id/text_empty_my_listings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/text_my_listings_subtitle"
        android:gravity="center"
        android:padding="@dimen/spacing_lg"
        android:text="@string/empty_my_listings"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_listing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="@dimen/spacing_lg"
        android:src="@drawable/ic_add"
        app:tint="@color/white"
        app:backgroundTint="@color/primary"
        android:contentDescription="@string/nav_sell" />

</RelativeLayout>
